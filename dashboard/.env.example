# ──────────────────────────────────────────────────────────────────────────────
# ClassPulse — Dashboard Environment Variables
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
#
# These variables are injected by Vite at build time (VITE_ prefix).
# They are safe to expose in client bundles — use the anon/public key only.
# Never put the service_role/secret key here.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project URL — found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (public) key — found in the same API settings page
VITE_SUPABASE_ANON_KEY=your-anon-key-here
